// Resource file: embeds the app icon + identifying strings into the .exe.
// Numeric IDs use the well-known IDI_ICON1 convention so Windows Explorer
// picks up the icon automatically without us defining a manifest.

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "flip_keeper.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Flip Keeper - Drop Detector Workbench"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "flip-keeper"
            VALUE "OriginalFilename","flip-keeper.exe"
            VALUE "ProductName",     "Flip Keeper"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
